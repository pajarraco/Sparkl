# Copy to .env and fill in real values. Never commit .env.
# Local defaults match docker-compose.dev.yml.

# PostgreSQL (Drizzle)
DATABASE_URL=postgres://sparkl:sparkl@localhost:5432/sparkl

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO local, R2/S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sparkl
S3_SECRET_KEY=sparkl1234
S3_FORCE_PATH_STYLE=true
AVATARS_BUCKET=avatars
JOBS_BUCKET=jobs

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins allowed to call the auth API (web client).
# Phone testing over Expo Go also needs exp://<PC-LAN-IP>:8081.
TRUSTED_ORIGINS=http://localhost:8081

# API
API_PORT=3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Unleash (ranking weight tuning)
UNLEASH_URL=
UNLEASH_API_TOKEN=

# Job-post assistant LLM (OpenAI-compatible chat completions)
# LLM_MODE: live (default) or fake. fake is refused unless NODE_ENV is test or development.
# Local (default): Ollama at http://localhost:11434/v1 with muse-glimmer:latest, no key.
# Real (paid): LLM_BASE_URL=https://inference.baseten.co/v1
#              LLM_MODEL=meta-models/muse-spark-open-1026
#              LLM_API_KEY=<your Baseten API key>
# A remote LLM_BASE_URL must use https and needs LLM_API_KEY.
LLM_MODE=live
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=muse-glimmer:latest
LLM_API_KEY=
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_MS=20000

# Address search + map pins (OpenStreetMap)
# GEO_PROVIDER: osm (only option for now; google can be added behind the same switch).
# Nominatim's usage policy requires an identifying User-Agent with a contact; required in production.
GEO_PROVIDER=osm
GEO_USER_AGENT=Sparkl/0.1 (contact: you@example.com)
GEO_PHOTON_URL=https://photon.komoot.io
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
