# Copy to .env and fill in real values. Never commit .env.
# Local defaults match docker-compose.dev.yml.

# PostgreSQL (Drizzle)
DATABASE_URL=postgres://sparkl:sparkl@localhost:5432/sparkl

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO local, R2/S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sparkl
S3_SECRET_KEY=sparkl1234
S3_FORCE_PATH_STYLE=true
AVATARS_BUCKET=avatars
JOBS_BUCKET=jobs

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins allowed to call the auth API (web client).
# Phone testing over Expo Go also needs exp://<PC-LAN-IP>:8081.
TRUSTED_ORIGINS=http://localhost:8081

# API
API_PORT=3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Unleash (ranking weight tuning)
UNLEASH_URL=
UNLEASH_API_TOKEN=

# Second worktree (optional): run a parallel stack next to the main one.
# Leave these unset in the main checkout. In the other worktree, set each
# port +1 (MinIO +2, since 9001 is the main console) and point the URLs
# above at them too (DATABASE_URL, REDIS_URL, S3_ENDPOINT, BETTER_AUTH_URL,
# TRUSTED_ORIGINS, API_PORT, EXPO_PUBLIC_API_URL). Expo web then runs with
# --port 8082, and apps/frontend/.env needs the same EXPO_PUBLIC_API_URL.
# SPARKL_STACK=sparkl-03
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# MINIO_PORT=9002
# MINIO_CONSOLE_PORT=9003
# SPKL_API_URL=http://localhost:3001
# SPKL_WEB_URL=http://localhost:8082
# SEED_ORIGIN=http://localhost:8082
