{
  "name": "Sparkl",
  "version": "1.0.0",
  "private": true,
  "description": "A two-sided marketplace connecting vacation-rental hosts with cleaning professionals",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-setup.mjs && pnpm --recursive --parallel run dev",
    "verify": "pnpm test && pnpm lint && pnpm typecheck",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.9.2",
    "vitest": "^3.0.5"
  },
  "author": "Ernesto La Fontaine",
  "license": "ISC"
}
